<Window x:Class="PRAKTOS_5_vagin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение троек" Height="620" Width="540"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Первая тройка" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="a1:" Target="tbFirst1" Margin="0,0,10,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbFirst1" Text="1" Margin="0,0,0,6"/>

                <Label Grid.Row="1" Grid.Column="0" Content="b1:" Target="tbSecond1" Margin="0,0,10,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbSecond1" Text="2" Margin="0,0,0,6"/>

                <Label Grid.Row="2" Grid.Column="0" Content="c1:" Target="tbThird1" Margin="0,0,10,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="tbThird1" Text="3"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Вторая тройка" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="a2:" Target="tbFirst2" Margin="0,0,10,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="tbFirst2" Text="1" Margin="0,0,0,6"/>

                <Label Grid.Row="1" Grid.Column="0" Content="b2:" Target="tbSecond2" Margin="0,0,10,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="tbSecond2" Text="2" Margin="0,0,0,6"/>

                <Label Grid.Row="2" Grid.Column="0" Content="c2:" Target="tbThird2" Margin="0,0,10,6"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="tbThird2" Text="3"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Label Content="Число для сравнения:" Target="tbNumber" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="tbNumber" Width="80" Text="1"/>
        </StackPanel>

        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button Content="Проверить тройки" Padding="12,5" Margin="0,0,8,0" Click="btnCompareTriads_Click"/>
            <Button Content="Сравнить с числом" Padding="12,5" Margin="0,0,8,0" Click="btnCompareNumber_Click"/>
            <Button Content="Очистить" Padding="12,5" Click="btnClear_Click"/>
        </WrapPanel>

        <GroupBox Grid.Row="4" Header="Результат" Padding="10" Margin="0,10,0,0">
            <ListBox x:Name="lbLog" BorderThickness="0" MinHeight="90"/>
        </GroupBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="О программе" Padding="12,5" Margin="0,0,8,0" Click="btnAbout_Click"/>
            <Button Content="Выход" Padding="12,5" Click="btnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>